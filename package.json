{
  "name": "paper-finder-student-mcp",
  "version": "0.1.2",
  "description": "Academic paper search MCP server. Search scholarly papers, list the papers of one author, do a citation lookup by DOI, find open access copies and related papers through OpenAlex. No API key needed.",
  "type": "module",
  "main": "build/src/index.js",
  "bin": {
    "paper-finder-student-mcp": "build/src/index.js"
  },
  "files": [
    "build/src",
    "README.md",
    "llms.txt",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/src/index.js', 0o755)\"",
    "test": "vitest run",
    "start": "node build/src/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "academic paper search mcp",
    "paper finder mcp",
    "paper search",
    "paper search mcp",
    "research paper search",
    "scholarly paper search",
    "openalex",
    "openalex mcp",
    "open access",
    "open access papers",
    "doi",
    "doi lookup",
    "citation lookup",
    "cited by",
    "related papers",
    "author papers",
    "author lookup",
    "literature review",
    "find 5 sources for my essay on spaced repetition",
    "find 5 sources for my essay",
    "sources for my essay",
    "essay sources",
    "citations for my literature review",
    "literature review citations",
    "essay citations",
    "find sources for essay",
    "student essay",
    "essay",
    "sources",
    "citations",
    "mcp",
    "mcp server",
    "model context protocol",
    "no api key",
    "claude",
    "cursor",
    "student",
    "education",
    "research"
  ],
  "author": "AnonymousOnyx22",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnonymousOnyx22/paper-finder-student-mcp.git"
  },
  "homepage": "https://github.com/AnonymousOnyx22/paper-finder-student-mcp#readme",
  "bugs": {
    "url": "https://github.com/AnonymousOnyx22/paper-finder-student-mcp/issues"
  },
  "mcpName": "io.github.AnonymousOnyx22/paper-finder-student-mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
